# OpenAI speech-to-text (audio is sent to OpenAI's API — not local/offline)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# OpenAI chat model used to turn one-take physician dictation into structured
# diagnosis/diagnostic-tests/treatment-plan fields. Uses the same
# OPENAI_API_KEY above. Optional — defaults to gpt-4o-mini.
OPENAI_EXTRACT_MODEL=gpt-4o-mini

# Mobile app patient login (routers/patient_auth.py). No SMS provider is
# wired up yet — with this on (the default), the OTP is printed to the
# console AND returned in the request-otp response as "devOtp" so the app
# can be developed/demoed without one. Set to "false" once a real SMS
# provider is integrated.
OTP_DEV_MODE=true
