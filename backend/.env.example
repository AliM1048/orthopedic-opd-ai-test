MONGO_URI=mongodb://localhost:27017

# faster-whisper transcription
# Model size: tiny/base/small/medium/large-v3 (bigger = more accurate, slower)
WHISPER_MODEL_SIZE=small
# Compute type: int8 is fastest on CPU; use float16 if running on a CUDA GPU
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# Local LLM (Ollama) used to turn one-take physician dictation into structured
# diagnosis/diagnostic-tests/treatment-plan fields. Requires Ollama running
# locally with the model pulled, e.g.: ollama pull mistral
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
