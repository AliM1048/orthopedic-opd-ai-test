# OpenAI speech-to-text (audio is sent to OpenAI's API — not local/offline)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local LLM (Ollama) used to turn one-take physician dictation into structured
# diagnosis/diagnostic-tests/treatment-plan fields. Requires Ollama running
# locally with the model pulled, e.g.: ollama pull mistral
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
